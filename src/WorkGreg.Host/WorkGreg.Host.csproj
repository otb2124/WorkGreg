<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>WorkGreg</RootNamespace>
		<AssemblyName>WorkGreg</AssemblyName>
		<UserSecretsId>a7854c93-1b2e-42aa-8675-721d0ecdaa2d</UserSecretsId>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<DebugType>none</DebugType>
		<IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WorkGreg.Core\WorkGreg.Core.csproj" />
		<ProjectReference Include="..\WorkGreg.Applier\WorkGreg.Applier.csproj" />
	</ItemGroup>

	<!-- SourceCatalog reads providers.json from the output folder. -->
	<ItemGroup>
		<Content Update="providers.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

</Project>