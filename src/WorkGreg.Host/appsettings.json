{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Urls": "http://localhost:5080",
  "Database": { "Path": "WorkGreg.db" },
  "Polling": {
    "IntervalMinutes": 60,
    "StartupDelaySeconds": 10,
    "MaxMessagesPerRun": 20,
