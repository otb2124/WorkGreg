{
  "Logging": {
    "Console": {
      "IncludeScopes": true
    },
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Core": {
    "BaseUrl": "http://localhost:5080"
  },
  "Bot": {
    "RateLimit": {
      "Enabled": true,
      "Burst": 8,
      "RefillPerSecond": 1.0,
      "NoticeIntervalSeconds": 10
    }
  }
}