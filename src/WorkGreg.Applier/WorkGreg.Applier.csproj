<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>WorkGreg</RootNamespace>
		<AssemblyName>WorkGreg.Applier</AssemblyName>
	</PropertyGroup>

	<!-- A plain class library does not get these implicitly (same as WorkGreg.Core). -->
	<ItemGroup>
		<Using Include="Microsoft.Extensions.DependencyInjection" />
		<Using Include="Microsoft.Extensions.Logging" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Playwright" Version="1.*" />
	</ItemGroup>

	<!-- Core must never reference Playwright; the dependency points this way only. -->
	<ItemGroup>
		<ProjectReference Include="..\WorkGreg.Core\WorkGreg.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WorkGreg.Tests" />
	</ItemGroup>

</Project>
