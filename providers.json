// Source catalog. To support a new website, add one entry to "providers" (and a fetcher, if its type is new).
//
// url           Request URL. "{keyword}" is replaced with the URL-escaped search keyword (omit it when the site has no
//               usable search: the keyword is then enforced locally and all searches share one request).
// type          Feed | Api | Html | Browser (a matching IJobFetcher must exist and be available).
// regions       Region ids from "regions" below; omitted = "global".
// api           For type Api. "extends" copies one of "apiTemplates", other fields override it (fieldMap is merged).
//               fieldMap needs at least "title" and "url"; the app refuses to start otherwise.
// note          Free text for humans, ignored by the app.
{
  "regions": [
    {
      "id": "hr",
      "label": "🇭🇷 Croatia"
    },
    {
      "id": "us",
      "label": "🇺🇸 USA"
    },
    {
      "id": "de",
      "label": "🇩🇪 Germany"
    },
    {
      "id": "eu",
      "label": "🇪🇺 Europe"
    },
    {
      "id": "pl",
      "label": "🇵🇱 Poland"
    },
    {
      "id": "ua",
      "label": "🇺🇦 Ukraine"
    },
    {
      "id": "global",
      "label": "🌍 Global / remote"
    }
  ],
  "apiTemplates": {
    "jobicy": {
      "itemsPath": "jobs",
      "fieldMap": {
        "id": "id",
        "title": "jobTitle",
        "url": "url",
        "company": "companyName",
        "location": "jobGeo",
        "description": "jobDescription",
        "posted": "pubDate"
      }
    },
    "arbeitnow": {
      "itemsPath": "data",
      "fieldMap": {
        "id": "slug",
        "title": "title",
        "url": "url",
        "company": "company_name",
        "location": "location",
        "description": "description",
        "posted": "created_at"
      }
    },
    "bundesagentur": {
      "headers": {
        "X-API-Key": "jobboerse-jobsuche"
      },
      "itemsPath": "stellenangebote",
      "missingItemsIsEmpty": true,
      "urlTemplate": "https://www.arbeitsagentur.de/jobsuche/jobdetail/{url}",
      "fieldMap": {
        "id": "refnr",
        "title": "titel",
        "url": "refnr",
        "company": "arbeitgeber",
        "location": "arbeitsort.ort",
        "description": "beruf",
        "posted": "aktuelleVeroeffentlichungsdatum"
      }
    },
    "greenhouse": {
      "itemsPath": "jobs",
      "fieldMap": {
        "id": "id",
        "title": "title",
        "url": "absolute_url",
        "location": "location.name",
        "description": "content",
        "posted": "updated_at"
      }
    },
    "lever": {
      "itemsPath": "",
      "fieldMap": {
        "id": "id",
        "title": "text",
        "url": "hostedUrl",
        "location": "categories.location",
        "description": "descriptionPlain",
        "posted": "createdAt",
        "employment": "categories.commitment"
      }
    },
    "ashby": {
      "itemsPath": "jobs",
      "fieldMap": {
        "id": "id",
        "title": "title",
        "url": "jobUrl",
        "location": "location",
        "description": "descriptionPlain",
        "posted": "publishedAt",
        "employment": "employmentType"
      }
    }
  },
  "providers": [

    // GLOBAL / REMOTE BOARDS
    {
      "id": "jobicy",
      "name": "Jobicy",
      "type": "Feed",
      "url": "https://jobicy.com/?feed=job_feed&search_keywords={keyword}",
      "keywordExamples": [ "developer", "angular", "dotnet" ]
    },
    {
      "id": "wwr",
      "name": "We Work Remotely",
      "type": "Feed",
      "url": "https://weworkremotely.com/remote-jobs.rss",
      "keywordExamples": [ "developer", "angular" ]
    },
    {
      "id": "remotive",
      "name": "Remotive",
      "type": "Api",
      "url": "https://remotive.com/api/remote-jobs",
      "keywordExamples": [ "full stack", "angular", ".net" ],
      "api": {
        "itemsPath": "jobs",
        "fieldMap": {
          "id": "id",
          "title": "title",
          "url": "url",
          "company": "company_name",
          "location": "candidate_required_location",
          "description": "description",
          "posted": "publication_date",
          "employment": "job_type"
        }
      },
      "note": "Remotive documents ?search= but it has been reported as ignored, so the keyword is enforced locally and every keyword shares one URL (fetched once per cycle)."
    },
    {
      "id": "remoteok",
      "name": "Remote OK",
      "type": "Api",
      "url": "https://remoteok.com/api",
